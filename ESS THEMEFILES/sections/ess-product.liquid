{%- style -%}
.ess-section-bg-{{ section.id }} {
    background-color:{{ section.settings.background_color }};
    color:{{ section.settings.text_color }};
    }
{% if section.settings.background_image != blank %}
.ess-section-bg-{{ section.id }} {
      background-image:url({{section.settings.background_image | image_url}});
    background-size: cover;
    background-attachment: unset;
    background-repeat: no-repeat;
    background-position: center;
    }
  {% endif %}
{% if section.settings.background_image_mobile != blank %}
  @media screen and (max-width: 915px) {
    .ess-section-bg-{{ section.id }} {
      background-image:url({{section.settings.background_image_mobile | image_url}});
    }
  }
  {% endif %}
  @media screen and (max-width: 915px) {
    .ess-section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
  @media screen and (min-width: 915px) {
    .ess-section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }  
{%- endstyle -%}
{%- liquid
  assign seo_product = product
  if section.settings.product != blank
    assign seo_product = section.settings.product
  endif
-%}

{%- comment -%}
  Cart configuration. These values used to be variant IDs hardcoded inside
  ess-pdp.js and ess-element-checkout-button.liquid, which is what stopped the
  files being reusable on another store. ess-cart.js reads them from here.
{%- endcomment -%}
<script type="application/json" id="ess-cart-config">
  {
    "protectionVariantId": {{ section.settings.protection_variant_id | strip | json }},
    "giftVariantId": {{ section.settings.gift_variant_id | strip | json }},
    "cartDrawerSection": {{ section.settings.cart_drawer_section | default: 'ess-cart-drawer' | json }},
    {%- comment -%}
      No `default: true` here on purpose. A checkbox returns false when the
      merchant unticks it, and `false | default: true` evaluates back to true
      in Liquid, which would silently ignore the setting.
    {%- endcomment -%}
    "cartCountExcludesProtection": {{ section.settings.count_excludes_protection | json }}
  }
</script>
<script>window.ESS_MONEY_FORMAT = {{ shop.money_format | json }};</script>

{%- comment -%}
  Preload the LCP candidate. On a PDP the first product image is almost always
  the Largest Contentful Paint element, so fetching it at high priority is the
  single biggest Core Web Vitals win available here.
{%- endcomment -%}
{%- if section.settings.preload_lcp_image and seo_product.featured_image != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ seo_product.featured_image | image_url: width: 1200 }}"
    imagesrcset="{{ seo_product.featured_image | image_url: width: 600 }} 600w, {{ seo_product.featured_image | image_url: width: 900 }} 900w, {{ seo_product.featured_image | image_url: width: 1200 }} 1200w"
    imagesizes="(max-width: 915px) 100vw, 50vw"
    fetchpriority="high"
  >
{%- endif -%}

{%- comment -%}
  Product structured data. Prices come straight from the variant objects, so
  the markup cannot drift from what the store actually charges.
{%- endcomment -%}
{%- if section.settings.enable_structured_data and seo_product != blank and seo_product.id != blank -%}
  {%- capture sd_offers -%}
    {%- for v in seo_product.variants -%}
      {
        "@type": "Offer",
        "sku": {{ v.sku | default: v.id | json }},
        "price": "{{ v.price | divided_by: 100.0 }}",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
        "url": "{{ shop.url }}{{ seo_product.url }}?variant={{ v.id }}"
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ seo_product.title | json }},
      "url": "{{ shop.url }}{{ seo_product.url }}",
      {% if seo_product.featured_image != blank %}"image": {{ seo_product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
      "description": {{ seo_product.description | strip_html | truncate: 500 | json }},
      {% if seo_product.vendor != blank %}"brand": { "@type": "Brand", "name": {{ seo_product.vendor | json }} },{% endif %}
      {% if seo_product.selected_or_first_available_variant.sku != blank %}"sku": {{ seo_product.selected_or_first_available_variant.sku | json }},{% endif %}
      "offers": [{{ sd_offers }}]
    }
  </script>
{%- endif -%}

<div class="ess-section-bg-{{ section.id }} ess-product {{ section.settings.custom_class }}" {% if section.settings.custom_id != blank %} id="{{ section.settings.custom_id }}" {% endif %} data-section-id="{{ section.id }}">
  <div class="ess-container ess-section-{{ section.id }}-padding">
    <div class="ess-product-content ess-text-{{ section.settings.text_alignment }}-desktop ess-text-{{ section.settings.text_alignment_mobile }}-mobile"> 
    <div class="ess-product-flex">
    <div class="ess-product-column ess-product-column1">
      {%- for block in section.blocks -%} 
            {%- case block.type -%} 
                {%- when 'product_media' -%} 
                    {%  render 'ess-element-product-media', block:block %}  
            {%  endcase %}
        {%  endfor %}  
    </div>
    <div class="ess-product-column ess-product-column2">
        {%- for block in section.blocks -%} 
            {%- case block.type -%} 
                {%- when 'heading' -%} 
                    {%  render 'ess-element-heading', block:block %} 
                {%- when 'richtext' -%} 
                    {%  render 'ess-element-richtext', block:block %} 
                {%- when 'image' -%} 
                    {%  render 'ess-element-image', block:block %} 
                {%- when 'liquid' -%} 
                    {%  render 'ess-element-liquid', block:block %} 
                {%- when 'icon_with_text' -%} 
                    {%  render 'ess-element-icon-with-text', block:block %} 
                {%- when 'faq' -%} 
                    {%  render 'ess-element-faq', block:block %} 
                {%- when 'options' -%} 
                    {%  render 'ess-element-options', block:block, section:section %} 
                {%- when 'checkout_button' -%} 
                    {%  render 'ess-element-checkout-button', block:block %} 
                {%- when 'icon_with_text_grid' -%} 
                    {%  render 'ess-element-icon-with-text-grid', block:block %} 
                {%- when 'variants' -%} 
                    {%  render 'ess-element-variants', block:block, section:section %} 
                {%- when 'subscription_widget' -%} 
                    {%  render 'ess-element-sub-widget', block:block %} 
                {%- when 'stock' -%} 
                    {%  render 'ess-element-stock', block:block %} 
            {%  endcase %}
        {%  endfor %}  
    </div>
    </div>
    </div>
  </div>
</div>
